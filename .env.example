# Optional. When set, each waitlist signup is POSTed here as JSON.
# Leave empty in local development to append leads to data/waitlist.jsonl.
# For production, use the Google Apps Script web app URL from scripts/waitlist-google-sheet.gs.
WAITLIST_WEBHOOK_URL=

# Used by the profile email code. Example for Gmail: smtp.gmail.com, port 587, and an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
